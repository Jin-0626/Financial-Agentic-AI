# Copy to .env; replace placeholders locally. Never commit real credentials.
DB_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/REPLACE_DATABASE
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OPEN_SANDBOX_DOMAIN=localhost:8080
OPEN_SANDBOX_API_KEY=REPLACE_WITH_EXISTING_SERVER_KEY
OPEN_SANDBOX_USE_SERVER_PROXY=true
SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.1
# Optional financial providers
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional: existing management server TOML, readable by this process
# OPEN_SANDBOX_CONFIG_FILE=

# Primary news search provider (optional; FMP/Yahoo remain fallbacks)
TAVILY_API_KEY=

# Phase 1 observability (isolated local Collector uses port 14317)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
APP_ENV=local
# Sentry is intentionally not initialized in Phase 1.

# Phase 2 native engine: trusted organization configuration, no automatic agent cutover.
ENGINE_ORG_ID=local-org
ENGINE_DATA_ROOT=.engine-data
ENGINE_COMPUTE_TIMEOUT_MS=30000
# ENGINE_COMMAND=["target/debug/financial-engine"]
