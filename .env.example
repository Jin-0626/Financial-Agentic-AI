# Application / authentication
# local permits development identity; production requires all four OIDC identity fields.
APP_ENV=local
# Enable portfolio routes: true or false. Documents are stored in SQLite.
PORTFOLIO_ENABLED=true
# Public issuer and JWKS URLs: HTTPS without embedded credentials.
OIDC_ISSUER=
OIDC_JWKS_URL=
# Expected API audience and registered public client ID.
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
# Verified organization claim; space-separated requested identity scopes.
OIDC_ORG_CLAIM=org_id
OIDC_SCOPE=openid profile
# Comma-separated trusted frontend origins; never wildcard. Empty for native-only access.
OIDC_CLIENT_ORIGINS=

# Research database / local storage
# PostgreSQL URI for research memory/checkpoints; create the database before startup.
DB_URL=postgresql://terminal:change-me@127.0.0.1:5432/analysis_deepagent
# Optional portfolio SQLite path, absolute or relative to the backend working directory.
# Default: OS application-data / financial-research-terminal/portfolios.sqlite3.
# PORTFOLIO_SQLITE_PATH=D:/financial-terminal/portfolios.sqlite3

# Research model / budgets
# Ollama server URL; use https://ollama.com for hosted models.
OLLAMA_URL=http://127.0.0.1:11434
# Provider-qualified model name; replace with an available local or hosted model.
MODEL_NAME=ollama:gpt-oss:120b-cloud
# Optional hosted key consumed by the Ollama client, never sent to the frontend.
OLLAMA_API_KEY=
# Positive integer limits shared by the parent agent and its specialists.
RESEARCH_MAX_TOKENS=1000000
RESEARCH_MAX_WALL_SECONDS=3600
# Optional offline analytics Python executable; defaults to analytics-runtime/.venv.
# ANALYTICS_PYTHON=D:/path/to/python.exe

# Native quantitative MCP engine
# Standalone CLI identity; backend MCP connections use verified organization identities.
ENGINE_ORG_ID=local-org
# Organization-scoped snapshot/artifact directory, relative to the working directory.
ENGINE_DATA_ROOT=.engine-data
# Compute deadline in milliseconds: integer 1 through 30000.
ENGINE_COMPUTE_TIMEOUT_MS=30000
# Optional trusted JSON argv array; default target/debug/financial-engine[.exe].
# ENGINE_COMMAND=["D:/financial-terminal/target/debug/financial-engine.exe"]
# Exact Yahoo ticker for standalone financial-engine fetch-fmp only.
# ENGINE_TICKER=5326.KL

# Tauri desktop (export in the launching shell; Tauri does not load this file)
# http uses the backend; mock generates deterministic local data.
TERMINAL_PROVIDER=http
# Backend origin only: HTTP loopback or trusted HTTPS, without paths or credentials.
TERMINAL_BACKEND_URL=http://127.0.0.1:8000
# Externally obtained bearer token when OIDC is required.
TERMINAL_ACCESS_TOKEN=
# Profile name: 1-64 ASCII letters, digits, underscores or hyphens.
TERMINAL_PROFILE=default

# Optional market / curated provider credentials
# FMP key for quote/news/research fallbacks and standalone FMP ingestion.
FMP_API_KEY=
# Tavily key for primary financial news search.
TAVILY_API_KEY=
# FRED economic series key, also used by the curated FRED provider.
FRED_API_KEY=
# CoinGecko demo key; public endpoints still work subject to provider limits.
COINGECKO_DEMO_API_KEY=
# SEC identity: application name and contact email, required for curated SEC calls.
SEC_USER_AGENT=
# Malaysia tracked set: 1-128 exact .KL tickers separated by commas/semicolons/spaces.
# Omit for the built-in 16-member set. Empty is invalid; suffixes are never guessed.
# MY_EQUITY_SYMBOLS=5326.KL,1155.KL,1295.KL,1023.KL
# Research Yahoo adapter network timeout in seconds; default 15.
YF_NET_TIMEOUT=15

# Verification only (use a dedicated disposable database, never production records)
# Optional PostgreSQL integration-test URI; unset skips database integration tests.
# TEST_DB_URL=postgresql://terminal:change-me@127.0.0.1:5432/terminal_test
# Optional trusted JSON argv array enabling native integration tests.
# ENGINE_TEST_COMMAND=["D:/financial-terminal/target/debug/financial-engine.exe"]
# Browser channel: msedge on Windows, or chromium after Playwright installation.
# PLAYWRIGHT_CHANNEL=msedge
