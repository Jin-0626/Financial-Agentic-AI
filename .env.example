# Copy to .env; replace placeholders locally. Never commit real credentials.
DB_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/REPLACE_DATABASE
# Optional remote host; leave unset to use the Ollama SDK's local host.
# For direct cloud API, select a model name returned by its /api/tags endpoint.
OLLAMA_URL=https://ollama.com
MODEL_NAME=ollama:gpt-oss:120b
OLLAMA_API_KEY=
# Optional financial providers
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Primary news search provider (optional; FMP/Yahoo remain fallbacks)
TAVILY_API_KEY=

# Phase 1 observability (isolated local Collector uses port 14317)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
APP_ENV=local
# Sentry is intentionally not initialized in Phase 1.

# Native Rust engine: organization-scoped MCP connections are managed by FastAPI.
# Standalone ingestion CLI only; requests use their workspace organization.
ENGINE_ORG_ID=local-org
ENGINE_DATA_ROOT=.engine-data
ENGINE_COMPUTE_TIMEOUT_MS=30000
# Windows native build:
# ENGINE_COMMAND=["target/debug/financial-engine.exe"]
# Linux and WSL builds are also supported; see README.

# Total input + output tokens per research request, shared by parent and specialists.
RESEARCH_MAX_TOKENS=1000000
RESEARCH_MAX_WALL_SECONDS=3600

# Optional curated script providers
FRED_API_KEY=
SEC_USER_AGENT=

# Isolated local portfolio beta; production is disabled until trusted identity is integrated.
PORTFOLIO_ENABLED=true

# Production identity: configure a public OIDC client using authorization-code + PKCE.
APP_ENV=local
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_ORG_CLAIM=org_id
OIDC_SCOPE=openid profile

# Explicit browser/desktop frontend origins; never wildcard.
OIDC_CLIENT_ORIGINS=
# Desktop builds: frontend/.env.production sets VITE_BACKEND_URL to the trusted HTTPS backend,
# and VITE_OIDC_REDIRECT_URI to the callback registered with the identity provider.
